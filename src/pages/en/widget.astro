---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/driver-income/" title="Net income calculator for taxi and VTC drivers in France" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the taxi and VTC driver net income calculator on your site" description="Embed the taxi and VTC net income calculator for France on your own site, free: one iframe code to copy, no sign-up, no tracking, all calculations in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the net income calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up, no fee. The iframe loads the full calculator from this site: driver associations, unions and newsrooms set it up in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the link shown under the calculator visible, do not alter the widget, and accept it as provided without warranty. Rates are updated on this site, so your embed stays current with no effort. For the French version, use <code>{`${SITE_URL}/embed/revenu-chauffeur/`}</code>.</p>
    <p>No data about your visitors reaches us: the calculation runs in their browser and the iframe sets no cookie. Questions? Use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/driver-income/" title="Net income calculator for taxi and VTC drivers in France" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
