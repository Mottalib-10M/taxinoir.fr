---
/** Accueil d'une langue : page pilier (RECETTE §5). Texte dans src/content/accueil.ts. */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, type Locale } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const parts = x.body(helpers(lang)).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const keys: SourceKey[] = ['spVtc', 'spTaxi', 'cmaT3p', 'cmaReglement', 'decretEquivalence', 'ctL3122_3', 'arreteVehicule', 'arreteDea', 'avenantAmbulanciers', 'urssafAe', 'urssafTns', 'cgi279'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const sim = route('revenu-net-chauffeur', lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
  </header>
  <Clamp text={x.resume} lang={lang} id="clamp-home" sentences={1} class="mb-2" />
  <MiniSim client:load kind="accueil" lang={lang} href={sim} />
  <div class="prose prose-slate max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={sim} />)}
  </div>
</PageLayout>
